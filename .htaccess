# Disable directory listing.
Options -Indexes

# URL aliases so the site can be reached at /survey and /admin/survey-results
# (matches the URL pattern used by the previous ICOLD survey deployment).
RewriteEngine On
RewriteRule ^survey/?$ index.php [L]
RewriteRule ^admin/survey-results/?$ admin/index.php [L]

# Defense in depth: block direct access to internal PHP includes even if
# PHP execution were ever misconfigured on this host.
<FilesMatch "^(admin_config|data_config|db|form_render)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
